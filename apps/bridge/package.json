{
  "name": "@rehau/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Node service that bridges the REHAU Nea Smart 2 web UI to REST + SSE + MQTT",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi:emit": "tsx src/scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/http-proxy": "^11.6.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@rehau/types": "*",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "mqtt": "^5.15.2",
    "pino": "^10.3.1",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.13.4",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
