{
  "name": "rehau-nea-smart-2",
  "version": "0.1.0",
  "private": true,
  "description": "REHAU Nea Smart 2 ↔ MQTT + REST API bridge with React control app",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "@types/react": "19.2.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "scripts": {
    "dev:bridge": "npm run dev -w @rehau/bridge",
    "dev:web": "npm run dev -w @rehau/web",
    "build": "npm run build -w @rehau/types && npm run build -w @rehau/bridge && npm run build -w @rehau/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "snapshot": "tsx scripts/snapshot.ts",
    "hashpw": "tsx scripts/hashpw.ts",
    "deploy:local": "node scripts/deploy-local.mjs"
  },
  "devDependencies": {
    "bcrypt": "^6.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "undici": "^8.10.2"
  }
}
